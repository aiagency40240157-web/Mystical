# ══════════════════════════════════════════════════════════════════════════════
#  Mystical — variables de PRODUCCIÓN (VPS self-hosted)
#  Copia este archivo a  .env  y rellena los valores.  NUNCA lo subas a git.
#
#    cp .env.prod.example .env
#    nano .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos (Postgres del propio VPS) ───────────────────────────────────
# POSTGRES_PASSWORD y la password dentro de DATABASE_URL DEBEN coincidir.
POSTGRES_USER=mystical
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD
POSTGRES_DB=mystical_db
DATABASE_URL=postgresql://mystical:CAMBIA_ESTA_PASSWORD@db:5432/mystical_db?schema=public

# ── Seguridad ─────────────────────────────────────────────────────────────────
# JWT_SECRET: mínimo 32 caracteres o el backend NO arranca (se apaga a propósito).
# Genera uno con:   openssl rand -base64 48
JWT_SECRET=CAMBIA_POR_UN_SECRETO_LARGO_MIN_32_CHARS

# API keys por rol (las usa el bot / integraciones). Genera cada una con openssl.
API_KEY_MANAGER=CAMBIA_ESTA_CLAVE
API_KEY_AGENT=CAMBIA_ESTA_CLAVE
API_KEY_ASSISTANT=CAMBIA_ESTA_CLAVE
API_KEY_SYSTEM=CAMBIA_ESTA_CLAVE

# Orígenes permitidos para el navegador. Con Caddy sirviendo todo en el mismo
# dominio no hace falta CORS, pero déjalo apuntando a tu IP/dominio público.
# Ejemplos:  http://203.0.113.45   ó   https://203-0-113-45.sslip.io
CORS_ORIGINS=http://TU_IP_PUBLICA

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_PRIVACY_ENGINE=true
ENABLE_AUDIT=true
ENABLE_WAITLIST=true
ENABLE_PAYMENTS=false
MOCK_PAYMENTS=false
CANCELLATION_WINDOW_HOURS=24

# ── Reporte diario por WhatsApp (opcional — deja vacío si no lo usas) ──────────
ADMIN_PHONE=
ASSISTANT_PHONE=

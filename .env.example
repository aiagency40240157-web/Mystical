DATABASE_URL=postgresql://postgres:password@localhost:5432/mystical_db
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins (add your production frontend URL)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://mystical-scheduling-2026.web.app,https://mystical-scheduling-2026.firebaseapp.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Production payment redirect URLs (backend Render service)
STRIPE_SUCCESS_URL=https://mystical-backend-eaf6.onrender.com/api/payments/success
STRIPE_CANCEL_URL=https://mystical-backend-eaf6.onrender.com/api/payments/cancel
# Set to true only in local dev to bypass real Stripe and use the mock-pay endpoint
MOCK_PAYMENTS=false
CANCELLATION_WINDOW_HOURS=24
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
# Phone numbers that receive the automated daily business report via WhatsApp (sent at 20:00 PT).
# Format: E.164 international format (e.g. +12135550100). Leave empty or omit to skip that recipient.
# Both variables are optional — the backend starts and runs normally if they are absent.
ADMIN_PHONE=+1234567890
ASSISTANT_PHONE=+0987654321
# RBAC API keys — set unique secrets per role in production
JWT_SECRET=replace-with-secure-jwt-secret-min-32-chars
API_KEY_MANAGER=replace-with-secure-secret
API_KEY_AGENT=replace-with-secure-secret
API_KEY_ASSISTANT=replace-with-secure-secret
API_KEY_SYSTEM=replace-with-secure-secret
# Feature flags — set to false to disable in development
ENABLE_PRIVACY_ENGINE=true
ENABLE_AUDIT=true
ENABLE_WAITLIST=true
ENABLE_PAYMENTS=true
